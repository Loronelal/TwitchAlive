{
  "manifest_version": 3,
  "name": "Twitch Keep Alive",
  "version": "1.8",
  "description": "Keeps Twitch tab active, favorites and drops progress locally.",
  "minimum_chrome_version": "111",
  "permissions": [ "activeTab", "storage" ],
  "action": {
    "default_title": "Twitch Keep Alive",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [ "*://*.twitch.tv/*" ],
      "js": [ "keepalive.js" ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [ "*://*.twitch.tv/*" ],
      "js": [ "settings.js", "content.js" ],
      "run_at": "document_start"
    },
    {
      "matches": [ "*://*.twitch.tv/*" ],
      "js": [ "gql-sniffer.js" ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [ "*://*.twitch.tv/*" ],
      "js": [ "favorites.js" ],
      "run_at": "document_idle"
    }
  ]
}
